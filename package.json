{
  "name": "boulder-quest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate_licenses.mjs",
    "build": "tsc && vite build",
    "build:android": "npm run build -- --mode android && cap sync android",
    "android:open": "cap open android",
    "icons": "node scripts/generate_icons.mjs",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#FFFFFF\" --splashBackgroundColor \"#FFFFFF\"",
    "sounds": "node scripts/generate_sounds.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.35.5",
    "typescript": "~5.5.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.36.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.68.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "use-sound": "^5.0.0"
  }
}
